---
import { SITE_TITLE, SOCIAL } from '../config.ts';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/blogs/', label: 'Posts' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];

// No Twitter/X link by design.
const icons = [
  { href: `https://github.com/${SOCIAL.github}`, label: 'GitHub', name: 'github' },
  { href: `https://www.linkedin.com/in/${SOCIAL.linkedin}/`, label: 'LinkedIn', name: 'linkedin' },
  { href: '/rss.xml', label: 'RSS feed', name: 'rss' },
] as const;
---

<header class="container site-header">
  <a class="name" href="/">{SITE_TITLE}</a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    {
      icons.map((icon) => (
        <a class="icon" href={icon.href} aria-label={icon.label} title={icon.label}>
          <Icon name={icon.name} />
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .name {
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 15px;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .icon {
    display: inline-flex;
  }
</style>
