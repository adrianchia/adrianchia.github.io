---
import { formatDate } from '../lib/posts.ts';
import { tagSlug } from '../lib/tags.ts';

interface Props {
  date: Date;
  readingMinutes: number;
  tags: string[];
}

const { date, readingMinutes, tags } = Astro.props;
---

<div class="post-meta mono">
  <time datetime={formatDate(date)}>{formatDate(date)}</time>
  <span aria-hidden="true"> · </span>{readingMinutes} min read
  {
    tags.map((tag) => (
      <>
        <span aria-hidden="true"> · </span>
        <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
      </>
    ))
  }
</div>

<style>
  .post-meta {
    font-size: 13px;
    color: var(--subtle);
  }
</style>
