{
  "name": "adrian-chia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Adrian Chia",
  "author": "Adrian Chia",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "sync": "node --env-file-if-exists=.env scripts/sync-notion.ts",
    "build": "pnpm sync && astro build",
    "build:site": "astro build",
    "build:fixtures": "rm -rf src/content/posts public/images/posts public/og/covers && mkdir -p src/content public/images public/og && cp -R tests/fixtures/posts src/content/posts && cp -R tests/fixtures/images public/images/posts && cp -R tests/fixtures/covers public/og/covers && astro build && node scripts/verify-dist.ts",
    "verify": "node scripts/verify-dist.ts",
    "test": "vitest run",
    "check": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "astro": "^7.4.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@notionhq/client": "^5.30.0",
    "astro-expressive-code": "^0.44.3",
    "katex": "^0.19.1",
    "lodash-es": "^4.18.1",
    "notion-to-md": "^3.1.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  }
}
